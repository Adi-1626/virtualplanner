      "url": "https://punemetrorail.org/project-profile",
      "page_rules": [
        {
          "id": "line1b_row",
          "project": "pune_metro_line_1b_swargate_katraj",
          "pattern": "Line 1 ?B Extension\\s+Swargate\\s*-\\s*Katraj\\s+(?P<length_km>\\d+(?:\\.\\d+)?)\\s*KM(?:\\s+(?P<station_count>\\d+)\\b)?",
          "note": "project-profile table row: corridor, length, underground stations"
        },
        {
          "id": "line1a_row",
          "project": "pune_metro_line_1a_pcmc_nigdi",
          "pattern": "Line 1 ?A Extension\\s+PCMC\\s*-\\s*Nigdi\\s+(?P<length_km>\\d+(?:\\.\\d+)?)\\s*KM\\s+-(?:\\s+(?P<station_count>\\d+)\\b)?",
          "note": "project-profile table row: corridor, length, -, elevated stations"
        }
      ]
    },
    {
      "id": "punemetrorail_line_1b",
      "kind": "official_page",
      "enabled": true,
      "publisher": "Maha-Metro (Pune Metro Rail Project)",
